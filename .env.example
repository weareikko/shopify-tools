# HTTP server
PORT=3000
HOST=0.0.0.0

# Access control — all MCP clients must send Authorization: Bearer <MCP_API_KEY>
# Generate with: openssl rand -hex 32
MCP_API_KEY=

# AES-256-GCM key for OAuth token encryption (required in production)
# Generate with: openssl rand -hex 32
OAUTH_SECRET=

# ------------------------------------------------------------------
# @shopify/dev-mcp — NO store credentials required
#
# Without any store config, @shopify/dev-mcp exposes 5 dev-docs tools:
#   learn_shopify_api, search_docs_chunks, validate_graphql_codeblocks,
#   validate_component_codeblocks, validate_theme
#
# If you configure a store below, additional store-management tools may
# appear. Set SHOPIFY_MCP_DOCS_ONLY=true to hide them.
# ------------------------------------------------------------------

# Optional: Shopify store credentials (only needed for store-management tools)
# SHOPIFY_FLAG_STORE=my-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...
# SHOPIFY_CLI_PARTNERS_TOKEN=

# ------------------------------------------------------------------
# Proxy tuning (optional)
# ------------------------------------------------------------------

# Override the command used to start @shopify/dev-mcp (default: npx)
# SHOPIFY_MCP_COMMAND=npx
# SHOPIFY_MCP_ARGS=["--yes","@shopify/dev-mcp"]
# SHOPIFY_MCP_MAX_RETRIES=10

# Expose only dev-docs/validation tools (hides store tools if a store is configured)
# SHOPIFY_MCP_DOCS_ONLY=true
