# HTTP server
PORT=3000
HOST=0.0.0.0

# Access control — all MCP clients must send Authorization: Bearer <MCP_API_KEY>
# Generate with: openssl rand -hex 32
MCP_API_KEY=

# AES-256-GCM key for OAuth token encryption (required in production)
# Generate with: openssl rand -hex 32
OAUTH_SECRET=

# ------------------------------------------------------------------
# @shopify/dev-mcp child process credentials
# These are forwarded to the child process via its environment.
# ------------------------------------------------------------------

# Required: your Shopify store hostname
SHOPIFY_FLAG_STORE=my-store.myshopify.com

# Custom app Admin API access token (shpat_...)
SHOPIFY_ACCESS_TOKEN=

# Partner API token (for partner-level access)
SHOPIFY_CLI_PARTNERS_TOKEN=

# ------------------------------------------------------------------
# Proxy tuning (optional)
# ------------------------------------------------------------------

# Override the command used to start @shopify/dev-mcp
# SHOPIFY_MCP_COMMAND=npx
# SHOPIFY_MCP_ARGS=["--yes","@shopify/dev-mcp"]
# SHOPIFY_MCP_MAX_RETRIES=10
