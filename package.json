{
  "name": "@ikko-dev/shopify-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Shopify tools — HTTP MCP proxy wrapping @shopify/dev-mcp for org-wide deployment",
  "keywords": [
    "ai-agent",
    "api",
    "automation",
    "mcp",
    "model-context-protocol",
    "shopify"
  ],
  "license": "MIT",
  "author": "ikko",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikko-dev/shopify-tools"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build -w @ikko-dev/shopify-mcp",
    "start:mcp": "npm run start -w @ikko-dev/shopify-mcp",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=verbose --reporter=junit --outputFile=test-results/junit.xml",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
