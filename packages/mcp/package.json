{
  "name": "@ikko-dev/shopify-mcp",
  "version": "0.1.0",
  "description": "MCP HTTP proxy for @shopify/dev-mcp — org-wide Shopify MCP server",
  "keywords": [
    "ai",
    "claude",
    "shopify",
    "mcp",
    "model-context-protocol",
    "remote",
    "http"
  ],
  "license": "MIT",
  "author": "ikko",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikko-dev/shopify-tools",
    "directory": "packages/mcp"
  },
  "bin": {
    "shopify-mcp-server": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=verbose --reporter=junit --outputFile=test-results/junit.xml",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "h3": "^2.0.0-rc.0"
  },
  "peerDependencies": {
    "@shopify/dev-mcp": "*"
  },
  "peerDependenciesMeta": {
    "@shopify/dev-mcp": {
      "optional": false
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
